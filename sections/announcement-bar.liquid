{{ 'component-slideshow.css' | asset_url | stylesheet_tag }}
{{ 'component-slider.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign social_icons = true
  if settings.social_facebook_link == blank and settings.social_instagram_link == blank and settings.social_youtube_link == blank and settings.social_tiktok_link == blank and settings.social_twitter_link == blank and settings.social_pinterest_link == blank and settings.social_snapchat_link == blank and settings.social_tumblr_link == blank and settings.social_vimeo_link == blank
    assign social_icons = false
  endif
  if section.settings.enable_country_selector or section.settings.enable_language_selector
    assign language_country_selector = true
  endif
  if section.blocks.size > 0
    assign announcement_bar = true
  endif

  # Scheduled announcements, such as a sale banner. Times are UTC ISO 8601, e.g. 2026-11-27T08:00:00Z.
  # A block needs both times; one with a missing or unreadable time never shows. B2B customers don't see them.
  assign announcement_now = 'now' | date: '%s' | plus: 0
  assign base_announcement_count = 0
  assign base_announcement_first = null
  assign scheduled_announcement_count = 0
  assign scheduled_announcement_first = null
  assign scheduled_announcement_ids = ''
  assign scheduled_announcement_live = false
  for announcement_block in section.blocks
    if announcement_block.settings.starts_at == blank and announcement_block.settings.ends_at == blank
      assign base_announcement_count = base_announcement_count | plus: 1
      if base_announcement_first == null
        assign base_announcement_first = announcement_block
      endif
      continue
    endif
    if customer.b2b?
      continue
    endif
    assign block_start = announcement_block.settings.starts_at | date: '%s' | plus: 0
    assign block_end = announcement_block.settings.ends_at | date: '%s' | plus: 0
    if block_start == 0 or block_end == 0 or announcement_now > block_end
      continue
    endif
    assign scheduled_announcement_count = scheduled_announcement_count | plus: 1
    assign scheduled_announcement_ids = scheduled_announcement_ids | append: ',' | append: announcement_block.id | append: ','
    # Several scheduled announcements share the first one's window.
    if scheduled_announcement_first == null
      assign scheduled_announcement_first = announcement_block
      assign scheduled_announcement_starts_at = announcement_block.settings.starts_at
      assign scheduled_announcement_ends_at = announcement_block.settings.ends_at
      if announcement_now >= block_start
        assign scheduled_announcement_live = true
      endif
    endif
  endfor
  # customer.b2b? is nil when nobody is signed in. In Liquid, nil == false
  # is false, so a == false check hides the retail link from guests.
  assign show_retail_announcement_link = false
  unless customer.b2b?
    assign show_retail_announcement_link = true
  endunless
-%}

{% if social_icons %}
  {{ 'component-list-social.css' | asset_url | stylesheet_tag }}
{% endif %}

{% style %}
  :root {
    --announcement-bar-height: 48px;
  }
  .utility-bar {
    position: fixed;
    top: 0;
    left: 0;
    padding-top: .5rem;
    width: 100%;
    height: var(--announcement-bar-height);
    z-index: 95;
    background-size: auto !important;
    overflow: hidden;
  }
{% endstyle %}

<div
  class="utility-bar color-{{ section.settings.color_scheme }} gradient{% if section.settings.show_line_separator and section.blocks.size > 0 %} utility-bar--bottom-border{% elsif section.settings.show_line_separator and section.settings.show_social and social_icons%} utility-bar--bottom-border-social-only{% endif %}{% if section.settings.enable_country_selector or section.settings.enable_language_selector %} header-localization{% endif %}"
  {{ block.shopify_attributes }}
>
  <div class="page-width utility-bar__grid{% if announcement_bar and language_country_selector or section.settings.show_social and social_icons %} utility-bar__grid--3-col{% elsif language_country_selector or section.settings.show_social and social_icons %} utility-bar__grid--2-col{% endif %}">
    {%- if section.settings.show_social and social_icons -%}
      {%- render 'social-icons' -%}
    {%- endif -%}
    {%- comment -%}
      Scheduled announcements (starts_at / ends_at set) join the bar only inside their window. Liquid drops
      them once they end. Until then the bar is rendered twice, without and with them, and <promotion-schedule>
      (assets/promotion-schedule.js) shows the right one from the browser clock, so cached pages switch on
      time. The variant that isn't current on the server is a <template>, so its slideshow starts only when shown.
    {%- endcomment -%}
    {%- liquid
      assign announcement_variants = 'base' | split: ','
      if scheduled_announcement_ids != blank
        assign announcement_variants = 'base,scheduled' | split: ','
      endif
    -%}
    {%- for announcement_variant in announcement_variants -%}
    {%- liquid
      assign announcement_count = base_announcement_count
      assign announcement_first = base_announcement_first
      if announcement_variant == 'scheduled'
        assign announcement_count = base_announcement_count | plus: scheduled_announcement_count
        assign announcement_first = base_announcement_first | default: scheduled_announcement_first
      endif
      assign announcement_slide_index = 0
    -%}
    {%- capture announcement_markup -%}
    {%- if announcement_count == 1 -%}
      <div
        class="announcement-bar{% if section.settings.show_social %} announcement-bar--one-announcement{% endif %}"
        role="region"
        aria-label="{{ 'sections.header.announcement' | t }}"
        {{ block.shopify_attributes }}
      >
        {%- if announcement_first.settings.text != blank -%}
          {%- if announcement_first.settings.link != blank and show_retail_announcement_link -%}
            <a
              href="{{ announcement_first.settings.link }}"
              class="announcement-bar__link link link--text focus-inset animate-arrow"
            >
          {%- endif -%}
          <p class="announcement-bar__message h5">
            <span>
              {%- if customer.b2b? -%}
                Wholesale ordering · Catalog pricing for approved dealers
              {%- else -%}
                {%- render 'announcement-bar-text', block: announcement_first -%}
              {%- endif -%}
            </span>
            {%- if announcement_first.settings.link != blank and show_retail_announcement_link -%}
              {{- 'icon-arrow.svg' | inline_asset_content -}}
            {%- endif -%}
          </p>
          {%- if announcement_first.settings.link != blank and show_retail_announcement_link -%}
            </a>
          {%- endif -%}
        {%- endif -%}
      </div>
    {%- elsif announcement_count > 1 -%}
      <slideshow-component
        class="announcement-bar"
        role="region"
        aria-roledescription="{{ 'sections.announcements.carousel' | t }}"
        aria-label="{{ 'sections.announcements.announcement_bar' | t }}"
      >
        <div class="announcement-bar-slider slider-buttons">
          <button
            type="button"
            class="slider-button slider-button--prev"
            name="previous"
            aria-label="{{ 'sections.announcements.previous_announcement' | t }}"
            aria-controls="Slider-{{ section.id }}"
          >
            <span class="svg-wrapper">
              {{- 'icon-caret.svg' | inline_asset_content -}}
            </span>
          </button>
          <div
            class="grid grid--1-col slider slider--everywhere"
            id="Slider-{{ section.id }}"
            aria-live="polite"
            aria-atomic="true"
            data-autoplay="{{ section.settings.auto_rotate }}"
            data-speed="{{ section.settings.change_slides_speed }}"
          >
            {%- for block in section.blocks -%}
              {%- liquid
                if block.settings.starts_at != blank or block.settings.ends_at != blank
                  assign announcement_block_key = ',' | append: block.id | append: ','
                  if announcement_variant == 'base'
                    continue
                  endif
                  unless scheduled_announcement_ids contains announcement_block_key
                    continue
                  endunless
                endif
                assign announcement_slide_index = announcement_slide_index | plus: 1
              -%}
              <div
                class="slideshow__slide slider__slide grid__item grid--1-col"
                id="Slide-{{ section.id }}-{{ announcement_slide_index }}"
                {{ block.shopify_attributes }}
                role="group"
                aria-roledescription="{{ 'sections.announcements.announcement' | t }}"
                aria-label="{{ announcement_slide_index }} {{ 'general.slider.of' | t }} {{ announcement_count }}"
                tabindex="-1"
              >
                <div
                  class="announcement-bar__announcement"
                  role="region"
                  aria-label="{{ 'sections.header.announcement' | t }}"
                  {{ block.shopify_attributes }}
                >
                  {%- if block.settings.text != blank -%}
                    {%- if block.settings.link != blank -%}
                      <a
                        href="{{ block.settings.link }}"
                        class="announcement-bar__link link link--text focus-inset animate-arrow"
                      >
                    {%- endif -%}
                    <p class="announcement-bar__message h5">
                      <span>
                        {%- if customer.b2b? -%}
                          Wholesale ordering · Catalog pricing for approved dealers
                        {%- else -%}
                          {%- render 'announcement-bar-text', block: block -%}
                        {%- endif -%}
                      </span>
                      {%- if block.settings.link != blank and show_retail_announcement_link -%}
                        {{- 'icon-arrow.svg' | inline_asset_content -}}
                      {%- endif -%}
                    </p>
                    {%- if block.settings.link != blank -%}
                      </a>
                    {%- endif -%}
                  {%- endif -%}
                </div>
              </div>
            {%- endfor -%}
          </div>
          <button
            type="button"
            class="slider-button slider-button--next"
            name="next"
            aria-label="{{ 'sections.announcements.next_announcement' | t }}"
            aria-controls="Slider-{{ section.id }}"
          >
            <span class="svg-wrapper">
              {{- 'icon-caret.svg' | inline_asset_content -}}
            </span>
          </button>
        </div>
      </slideshow-component>
      {%- if request.design_mode -%}
        <script src="{{ 'theme-editor.js' | asset_url }}" defer="defer"></script>
        <style>
          /* theme editor power preview fix */
          .announcement-bar-slider .slider__slide[aria-hidden='true'] {
            visibility: hidden;
          }
        </style>
      {%- endif -%}
    {%- endif -%}
    {%- endcapture -%}
    {%- if announcement_variant == 'base' -%}
      {%- assign base_announcement_markup = announcement_markup -%}
    {%- else -%}
      {%- assign scheduled_announcement_markup = announcement_markup -%}
    {%- endif -%}
    {%- endfor -%}
    {%- if scheduled_announcement_ids == blank -%}
      {{- base_announcement_markup -}}
    {%- else -%}
      <promotion-schedule
        class="announcement-bar-schedule"
        data-starts-at="{{ scheduled_announcement_starts_at | escape }}"
        data-ends-at="{{ scheduled_announcement_ends_at | escape }}"
      >
        {%- if scheduled_announcement_live -%}
          <div class="promotion-state" data-promotion-active>{{ scheduled_announcement_markup }}</div>
          <template data-promotion-stamp="inactive">
            <div class="promotion-state" data-promotion-inactive>{{ base_announcement_markup }}</div>
          </template>
        {%- else -%}
          <div class="promotion-state" data-promotion-inactive>{{ base_announcement_markup }}</div>
          <template data-promotion-stamp="active">
            <div class="promotion-state" data-promotion-active>{{ scheduled_announcement_markup }}</div>
          </template>
        {%- endif -%}
      </promotion-schedule>
    {%- endif -%}
    <div class="localization-wrapper">
      {%- if section.settings.enable_country_selector and localization.available_countries.size > 1 -%}
        <localization-form class="small-hide medium-hide">
          {%- form 'localization', id: 'AnnouncementCountryForm', class: 'localization-form' -%}
            <div>
              <h2 class="visually-hidden" id="AnnouncementCountryLabel">{{ 'localization.country_label' | t }}</h2>
              {%- render 'country-localization', localPosition: 'AnnouncementCountry' -%}
            </div>
          {%- endform -%}
        </localization-form>
      {% endif %}

      {%- if section.settings.enable_language_selector and localization.available_languages.size > 1 -%}
        <localization-form class="small-hide medium-hide">
          {%- form 'localization', id: 'AnnouncementLanguageForm', class: 'localization-form' -%}
            <div>
              <h2 class="visually-hidden" id="AnnouncementLanguageLabel">{{ 'localization.language_label' | t }}</h2>
              {%- render 'language-localization', localPosition: 'AnnouncementLanguage' -%}
            </div>
          {%- endform -%}
        </localization-form>
      {%- endif -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "t:sections.announcement-bar.name",
  "max_blocks": 12,
  "class": "announcement-bar-section",
  "enabled_on": {
    "groups": ["header"]
  },
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-4"
    },
    {
      "type": "checkbox",
      "id": "show_line_separator",
      "default": true,
      "label": "t:sections.header.settings.show_line_separator.label"
    },
    {
      "type": "header",
      "content": "t:sections.announcement-bar.settings.header__1.content",
      "info": "t:sections.announcement-bar.settings.header__1.info"
    },
    {
      "type": "checkbox",
      "id": "show_social",
      "default": false,
      "label": "t:sections.announcement-bar.settings.show_social.label"
    },
    {
      "type": "header",
      "content": "t:sections.announcement-bar.settings.header__2.content"
    },
    {
      "type": "checkbox",
      "id": "auto_rotate",
      "label": "t:sections.announcement-bar.settings.auto_rotate.label",
      "default": false
    },
    {
      "type": "range",
      "id": "change_slides_speed",
      "min": 3,
      "max": 10,
      "step": 1,
      "unit": "s",
      "label": "t:sections.announcement-bar.settings.change_slides_speed.label",
      "default": 5
    },
    {
      "type": "header",
      "content": "t:sections.announcement-bar.settings.header__3.content",
      "info": "t:sections.announcement-bar.settings.header__3.info"
    },
    {
      "type": "checkbox",
      "id": "enable_country_selector",
      "default": false,
      "label": "t:sections.announcement-bar.settings.enable_country_selector.label"
    },
    {
      "type": "header",
      "content": "t:sections.announcement-bar.settings.header__4.content",
      "info": "t:sections.announcement-bar.settings.header__4.info"
    },
    {
      "type": "checkbox",
      "id": "enable_language_selector",
      "default": false,
      "label": "t:sections.announcement-bar.settings.enable_language_selector.label"
    }
  ],
  "blocks": [
    {
      "type": "announcement",
      "name": "t:sections.announcement-bar.blocks.announcement.name",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "default": "t:sections.announcement-bar.blocks.announcement.settings.text.default",
          "label": "t:sections.announcement-bar.blocks.announcement.settings.text.label"
        },
        {
          "type": "url",
          "id": "link",
          "label": "t:sections.announcement-bar.blocks.announcement.settings.link.label"
        },
        {
          "type": "text",
          "id": "mobile_text",
          "label": "t:sections.announcement-bar.blocks.announcement.settings.mobile_text.label",
          "info": "t:sections.announcement-bar.blocks.announcement.settings.mobile_text.info"
        },
        {
          "type": "header",
          "content": "t:sections.announcement-bar.blocks.announcement.settings.header_schedule.content",
          "info": "t:sections.announcement-bar.blocks.announcement.settings.header_schedule.info"
        },
        {
          "type": "text",
          "id": "starts_at",
          "label": "t:sections.announcement-bar.blocks.announcement.settings.starts_at.label",
          "placeholder": "2026-11-27T08:00:00Z"
        },
        {
          "type": "text",
          "id": "ends_at",
          "label": "t:sections.announcement-bar.blocks.announcement.settings.ends_at.label",
          "placeholder": "2026-12-04T07:59:59Z"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:sections.announcement-bar.presets.name",
      "blocks": [
        {
          "type": "announcement"
        }
      ]
    }
  ]
}
{% endschema %}
